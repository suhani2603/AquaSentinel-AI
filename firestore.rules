rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthorizedResponder() {
      return isSignedIn() && (
        request.auth.token.email == 'suhanichadha017@gmail.com' ||
        exists(/databases/$(database)/documents/responders/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User-isolated collections & subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Emergency Reports (Public awareness for community safety, authenticated creation & responder management)
    match /emergency_reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(reportId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.peopleNeedingAssistance is number
        && request.resource.data.peopleNeedingAssistance >= 1
        && request.resource.data.peopleNeedingAssistance <= 5000;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAuthorizedResponder()
      );

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAuthorizedResponder()
      );
    }

    // Community People Needing Assistance Reports
    match /community_people_reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(reportId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reportedCount is number
        && request.resource.data.reportedCount >= 1;
        
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAuthorizedResponder()
      );
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
